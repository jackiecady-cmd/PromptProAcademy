# Copy to .env and fill in. Never commit .env or real keys.

# Required for the database and sessions (Postgres connection string)
DATABASE_URL=
SESSION_SECRET=generate-a-long-random-string

# Public URL of this app (Stripe success/cancel links)
APP_URL=http://localhost:5000
PORT=5000
NODE_ENV=development

# OpenAI (use a real key locally or on Railway/Render/Fly — not Replit's proxy)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stripe (leave empty to run without payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: keep Replit Login while still hosted on Replit
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc
